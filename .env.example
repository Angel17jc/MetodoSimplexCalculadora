# Copia este archivo como .env y ajusta los valores.
# docker compose lo lee automáticamente.

# desarrollo o produccion
ENTORNO=desarrollo

# Base de datos OPCIONAL.
# Si la dejas vacía o la borras, la app funciona igual pero sin guardar ni compartir problemas.
# Dentro de Docker el servidor se llama "db"; fuera de Docker usa localhost.
DATABASE_URL=postgresql+psycopg://simplex:simplex@db:5432/simplex

# Credenciales del contenedor de PostgreSQL
POSTGRES_USER=simplex
POSTGRES_PASSWORD=simplex
POSTGRES_DB=simplex

# Orígenes permitidos por CORS (lista JSON). En producción el front y la API comparten dominio.
CORS_ORIGENES=["http://localhost:5173"]

# Puertos en tu equipo
WEB_PORT=5173
API_PORT=8000
